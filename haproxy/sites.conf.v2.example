# HAProxy конфигурация (v2) — пример
# Скопируй как sites.conf и отредактируй. Или: migrate.sh для переезда с v1.
#
# Правила формата:
#   WEB_SITES:     "домен:порт[:path=/prefix][:опции...]"
#     - одна запись на домен без path  => поведение v1 (host -> backend)
#     - несколько записей на домен     => path-правила ставятся ВЫШЕ общего
#       (пример ниже: /data/ -> 11443, остальное -> 8080)
#   REALITY_SITES: "домен[ домен...]:порт[:proxy=off|v1|v2]"
#     - каждая запись => СВОЙ backend (порт и PROXY берутся из записи)
#     - proxy=v2  => send-proxy-v2 на backend (пара к accept-proxy!)
#   GLOBAL_OPTS:   "ключ=значение" (см. все ключи ниже)

ACME_EMAIL="mailname@example.com"

# Сайты (L7, SSL termination через haproxy-web)
WEB_SITES=(
  # Простой сайт как в v1:
  "site1.com:8080"
  # Один домен, два бэкенда: API-путь в Xray, остальное в статику:
  # "x.cdn.example.com:11443:path=/data/"
  # "x.cdn.example.com:8080"
)

# Reality (L4, напрямую на xray)
REALITY_SITES=(
  # Одна запись (как v1) => один backend bk_xray:
  "google.com www.google.com:10443"
  # Вторая запись => свой backend bk_xray_2 со своим портом и PROXY:
  # "other.example.com:10444:proxy=v2"
)

# Глобальные опции (значения ниже = поведение v1 по умолчанию)
GLOBAL_OPTS=(
  "timeout_connect=5s"
  "timeout_client=50s"    # подними (1h) для долгих proxy-сессий
  "timeout_server=50s"    # подними (1h) для долгих proxy-сессий
  # "timeout_tunnel=1h"   # раскомментировать для стримов/XHTTP-даунлинков
  "bind_stream=*:443"
  "bind_web=*:8443"       # для loopback-only: 127.0.0.1:8443
  "blackhole=deny"        # deny|tarpit
  # "blackhole_deny_status=404"  # код для deny (100-599), дефолт 403
  # PROXY-пара stream->web (должны совпадать, иначе рассинхрон!):
  # "stream_web_proxy=off"  # off|v1|v2 — слать PROXY в web-бэкенд
  # "web_accept_proxy=off"  # off|on — читать PROXY на bind web
  # "backend_check=off"     # off|tcp — healthcheck-и бэкендов (шумят в логах!)
  # "forwardfor_backends="  # теги бэкендов через запятую для option forwardfor,
                            # напр. "bk_site_x_example_com_11443" (тег = site_ + домен
                            # с точками в _ + _порт, если записей на домен несколько)
  # "stream_log_sni=off"    # off|on — SNI в stream-лог (атрибуция пачек)
  # "web_capture_headers=off"  # off|on — capture Host и X-Forwarded-For в web-лог
)
